# Copy this file to observability/.env and replace the value with a freshly
# generated token, for example: openssl rand -hex 32
#
# This token is passed to Grafana only. Start the macOS notifier with the same
# value as WEBHOOK_SECRET (see docs/observability.md).
GRAFANA_WEBHOOK_TOKEN=replace-with-a-random-token

# Optional API endpoint. Source this file before starting the FastAPI service
# when Ollama is not running at the default local address.
OLLAMA_GENERATE_URL=http://localhost:11434/api/generate

# Process-local backpressure for /generate. At most this many calls reach
# Ollama at once; extra callers receive HTTP 503 after the queue timeout.
MAX_CONCURRENT_INFERENCE=3
INFERENCE_QUEUE_TIMEOUT=5
