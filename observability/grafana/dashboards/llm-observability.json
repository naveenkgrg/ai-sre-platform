{
  "id": null,
  "uid": "ollama-llm-observability",
  "title": "LLM Observability | Ollama + FastAPI",
  "tags": ["llm", "ollama", "fastapi", "prometheus"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {"from": "now-1h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "model",
        "label": "Model",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "query": "label_values(llm_requests_total, model)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "current": {"text": "All", "value": "$__all"}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Total LLM Requests",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0},
      "targets": [{"expr": "sum(llm_requests_total{model=~\"$model\"})", "refId": "A"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "values": false}, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "area"}
    },
    {
      "id": 2,
      "title": "Successful Requests",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 0},
      "targets": [{"expr": "sum(llm_requests_total{http_status=\"200\",model=~\"$model\"}) or vector(0)", "refId": "A"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "values": false}, "colorMode": "value", "graphMode": "area"}
    },
    {
      "id": 3,
      "title": "LLM Timeouts",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 0},
      "targets": [{"expr": "sum(llm_timeouts_total{model=~\"$model\"}) or vector(0)", "refId": "A"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "values": false}, "colorMode": "value", "graphMode": "area"}
    },
    {
      "id": 4,
      "title": "Timeout Percentage",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 0},
      "targets": [{"expr": "100 * (sum(llm_requests_total{http_status=\"504\",model=~\"$model\"}) or vector(0)) / clamp_min(sum(llm_requests_total{model=~\"$model\"}), 1)", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent", "decimals": 1}},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "values": false}, "colorMode": "value", "graphMode": "area"}
    },
    {
      "id": 5,
      "title": "Average LLM Request Latency",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5},
      "targets": [{"expr": "sum(rate(llm_request_duration_seconds_sum{model=~\"$model\"}[5m])) / sum(rate(llm_request_duration_seconds_count{model=~\"$model\"}[5m]))", "legendFormat": "Average latency", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}}
    },
    {
      "id": 6,
      "title": "P95 LLM Request Latency",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(llm_request_duration_seconds_bucket{model=~\"$model\"}[5m])))", "legendFormat": "P95 latency", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}}
    },
    {
      "id": 7,
      "title": "LLM Requests by HTTP Status",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 13},
      "targets": [{"expr": "sum by (http_status) (rate(llm_requests_total{model=~\"$model\"}[5m]))", "legendFormat": "HTTP {{http_status}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}}
    },
    {
      "id": 8,
      "title": "LLM Request Throughput",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 13},
      "targets": [{"expr": "sum by (model) (rate(llm_requests_total{model=~\"$model\"}[5m]))", "legendFormat": "{{model}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}}
    }
  ]
}
